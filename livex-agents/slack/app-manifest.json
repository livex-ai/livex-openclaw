{
  "display_information": {
    "name": "LiveX Reporting",
    "description": "Agent-backed on-call coordination and read-only incident investigation."
  },
  "features": {
    "bot_user": {
      "display_name": "LiveX Reporting",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "channels:read",
        "chat:write",
        "chat:write.customize",
        "groups:history",
        "groups:read",
        "reactions:read",
        "reactions:write",
        "users:read"
      ]
    }
  },
  "settings": {
    "socket_mode_enabled": true,
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.channels",
        "message.groups"
      ]
    }
  }
}
