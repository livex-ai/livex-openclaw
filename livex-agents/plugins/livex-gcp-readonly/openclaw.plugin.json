{
  "id": "livex-gcp-readonly",
  "name": "LiveX investigation evidence",
  "description": "Read-only investigation evidence for an authorized Slack caller in configured channels.",
  "version": "0.1.0",
  "contracts": {
    "tools": [
      "livex_gcp_logs_read",
      "livex_repository_read",
      "livex_oncall_logs_read",
      "livex_oncall_assessment_submit"
    ]
  },
  "toolMetadata": {
    "livex_gcp_logs_read": {
      "optional": true,
      "sideEffecting": false,
      "replaySafe": true
    },
    "livex_repository_read": {
      "optional": true,
      "sideEffecting": false,
      "replaySafe": true
    },
    "livex_oncall_logs_read": {
      "optional": true,
      "sideEffecting": false,
      "replaySafe": false
    },
    "livex_oncall_assessment_submit": {
      "optional": true,
      "sideEffecting": true,
      "replaySafe": false
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "gcloudPath",
      "cloudSdkConfig",
      "gcloudAccount",
      "project",
      "allowedChannelId",
      "allowedSenderId"
    ],
    "properties": {
      "gcloudPath": {
        "type": "string",
        "minLength": 1
      },
      "cloudSdkConfig": {
        "type": "string",
        "minLength": 1
      },
      "gcloudAccount": {
        "type": "string",
        "minLength": 1,
        "maxLength": 254,
        "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+$"
      },
      "project": {
        "type": "string",
        "minLength": 1
      },
      "allowedChannelId": {
        "type": "string",
        "pattern": "^(?:\\*|[CG][A-Z0-9]+)$",
        "description": "Slack channel ID or * for all accessible public/private channels. Keep Slack group DMs disabled."
      },
      "allowedSenderId": {
        "type": "string",
        "minLength": 1
      },
      "paging": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false,
            "description": "Enable durable, conversation-scoped continuation for bounded log pages. Omit or disable to use the existing gcloud reader."
          },
          "pythonPath": {
            "type": "string",
            "minLength": 1,
            "pattern": "^/[^\\u0000-\\u001f]*$",
            "description": "Absolute path to the local Python interpreter for the read-only paging helper."
          },
          "sdkRoot": {
            "type": "string",
            "minLength": 1,
            "pattern": "^/[^\\u0000-\\u001f]*$",
            "description": "Absolute path to the installed Google Cloud SDK root. Uses the existing configured account and Cloud SDK state."
          }
        },
        "if": {
          "properties": {
            "enabled": {
              "const": true
            }
          },
          "required": [
            "enabled"
          ]
        },
        "then": {
          "required": [
            "pythonPath",
            "sdkRoot"
          ]
        }
      },
      "repositories": {
        "type": "array",
        "default": [],
        "maxItems": 64,
        "description": "Operator-approved local repository snapshots. Empty by default; commits are not automatically refreshed or assumed deployed.",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "path",
            "commit"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^/[^\\u0000-\\u001f]*$",
              "description": "Canonical absolute checkout path; never supplied by the model."
            },
            "commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$",
              "description": "Operator-pinned immutable commit SHA."
            }
          }
        }
      },
      "oncall": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "accountId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "teamId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^T[A-Z0-9]+$"
          },
          "channelId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[CG][A-Z0-9]+$"
          },
          "publisherBotId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^B[A-Z0-9]+$"
          },
          "publisherAppId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^A[A-Z0-9]+$"
          },
          "historicalSenderId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[UW][A-Z0-9]+$"
          },
          "environment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "resourceType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,127}$"
          },
          "broadcastChannelId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[CG][A-Z0-9]+$"
          },
          "resourceLabels": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 16,
            "propertyNames": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "tickMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60000
          },
          "maxRunMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600000
          },
          "maxLogCalls": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "maxLogBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 307200
          },
          "maxScanPages": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "maxReceipts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2000
          },
          "maxConcurrent": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "maxNudges": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "reminderMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600000
          }
        },
        "if": {
          "properties": {
            "enabled": {
              "const": true
            }
          },
          "required": [
            "enabled"
          ]
        },
        "then": {
          "required": [
            "accountId",
            "teamId",
            "channelId",
            "publisherBotId",
            "historicalSenderId",
            "environment",
            "resourceType",
            "resourceLabels"
          ]
        }
      }
    }
  }
}
