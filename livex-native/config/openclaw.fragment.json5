// LiveX on stock OpenClaw: merge these keys into ~/.openclaw/openclaw.json.
//
// Set the environment variables below for the Gateway process (or replace the
// ${...} placeholders with literal values). Missing variables stay visibly unresolved
// and the plugin stays disabled until its required config resolves.
//
// Everything here is ordinary config; no OpenClaw core patches are needed.
// Slack bot and app tokens are not part of this fragment: set them the way you
// already do for your Slack app (channels.slack.botToken / appToken, or
// `openclaw channels add --channel slack`).
{
  plugins: {
    // Keep any ids you already allow (for example your channels) in this list.
    allow: ["openai", "codex", "slack", "livex-gcp-readonly", "livex-slack-summary"],
    entries: {
      openai: { enabled: true },
      // Codex is the agent's brain: OpenAI model turns run in the Codex app-server.
      codex: {
        enabled: true,
        config: {
          // Codex's native shell stays available inside a read-only sandbox.
          // With tools.exec.mode "ask" the effective policy is sandbox read-only,
          // approvalPolicy on-request, approvalsReviewer user: any escalation
          // request goes to a human (extensions/codex/src/app-server/config.test.ts:141-153).
          appServer: {
            homeScope: "agent",
            sandbox: "read-only",
            approvalPolicy: "on-request",
          },
          sessionCatalog: { enabled: false },
          supervision: { enabled: false },
        },
      },
      slack: { enabled: true },
      "livex-slack-summary": { enabled: true },
      "livex-gcp-readonly": {
        enabled: true,
        config: {
          gcloudPath: "${GCLOUD_PATH}",
          cloudSdkConfig: "${CLOUDSDK_CONFIG}",
          gcloudAccount: "${GCLOUD_ACCOUNT}",
          project: "${GCP_PROJECT}",
          allowedChannelId: "*",
          allowedSenderId: "${SLACK_SENDER_ID}",
          paging: {
            enabled: true,
            pythonPath: "${PYTHON_PATH}",
            sdkRoot: "${GCLOUD_SDK_ROOT}",
          },
          repositories: [],
        },
      },
    },
    // setup.sh links both local plugins and records their absolute paths.
    // For manual setup, add one load path for each local plugin.
  },

  // Every openai/* model turn uses the Codex runtime (/status: "Runtime: OpenAI Codex").
  models: {
    providers: {
      openai: {
        agentRuntime: { id: "codex" },
      },
    },
  },

  agents: {
    // `openclaw agents add <id> ...` (scripts/setup.sh) creates each entry and
    // writes its absolute workspace path; merge the rest into it. workspace is
    // intentionally omitted here so a merge never replaces that path. Without
    // setup.sh, add workspace: "<absolute path to livex-native>/agents/<id>".
    //
    // A roster with more than one agent needs ownership: "explicit" or exactly
    // one legacy default: true entry, and "explicit" cannot be combined with a
    // default: true marker (src/config/zod-schema.agents.ts:72-86). If your
    // config has a default: true entry, delete the marker and move that id to
    // agents.defaults.systemAgent.agentId; otherwise unbound traffic has no
    // owner and routing throws.
    ownership: "explicit",
    defaults: {
      timeoutSeconds: 1200,
      maxConcurrent: 5,
      // debugger is the default agent. When `agents add` grows a
      // one-agent roster it pins the previous sole agent (often `main`) here
      // (src/commands/agents.config.ts:161-186); merging this fragment REPLACES
      // that value, so unbound traffic and ambient system work go to debugger.
      systemAgent: { agentId: "debugger" },
      // authInheritance is deliberately not set (PR #1 set it to "main"). It is
      // an upgrade-only owner for a legacy credential store; it already falls
      // back to the legacy data owner, else "main"
      // (src/agents/legacy-inherited-auth-dir.ts:9-14), and
      // config writes pin it automatically when the former owner was not main
      // (src/config/io.auth-inheritance-owner.ts). Forcing "main" here could
      // overwrite that pin on an upgraded install and is a no-op on a fresh one.
    },
    entries: {
      debugger: {
        name: "LiveX Debugger",
        identity: { name: "LiveX Reporting · Debugger" },
        description: "Slack alert triage and deeper production diagnosis from admitted read-only evidence.",
        model: "openai/gpt-6-astra",
        skills: [
          "investigate-alerts",
          "debug",
          "systematic-debugging",
          "verification-before-completion",
        ],
        tools: {
          // The global profile is "minimal" (below). The agent profile wins over
          // it (src/agents/agent-tools.policy.ts:338-339), and the profile step
          // runs BEFORE the allow list, so without "full" the allow list below
          // would be intersected away (tool-policy-pipeline.ts:75-112, 200;
          // minimal lists only a few core tools, tool-catalog.ts:347-349).
          profile: "full",
          // OpenClaw tool allowlist: governs OpenClaw-managed tools only (the two
          // LiveX evidence tools plus read-only helpers). Codex's native shell is
          // bounded by the read-only appServer sandbox above, not by this list.
          allow: [
            "read",
            "skills_read",
            "message",
            "livex_gcp_logs_read",
            "livex_repository_read",
          ],
          message: { actions: { allow: ["read", "reactions"] } },
          // "deny"/"allowlist" fail Codex preflight
          // (extensions/codex/src/app-server/config-exec-policy.ts:93-103).
          // "auto" forces model-backed approval review. "ask" keeps the read-only
          // sandbox and routes any escalation request to a human.
          exec: { mode: "ask" },
          elevated: { enabled: false },
          fs: { workspaceOnly: true },
        },
      },
    },
  },

  // Global tool floor, as in PR #1: every agent without its own settings gets
  // the minimal profile, no elevated mode, and no unattended exec.
  tools: {
    profile: "minimal",
    // PR #1 used mode "deny" here. On the Codex runtime that fails preflight for
    // every agent that sets no exec mode of its own, including the `main` agent
    // that `agents add` creates (extensions/codex/src/app-server/config-options.ts:148-152,
    // config-exec-policy.ts:93-103). An agent's own mode replaces the global one
    // (extensions/codex/src/app-server/config-exec-approvals.ts:33-41), so debugger works either way;
    // "ask" keeps all other agents runnable and sends escalation to a human.
    exec: { mode: "ask" },
    elevated: { enabled: false },
  },

  // Slack behavior ported from PR #1's deployed config. Tokens are set elsewhere.
  channels: {
    slack: {
      enabled: true,
      groupPolicy: "open",
      allowBots: false,
      joinIntro: false,
      // No ack or typing reactions.
      ackReaction: "",
      typingReaction: "",
      requireMention: true,
      // Only the configured user can talk to the bot, in any channel it is in.
      allowFrom: ["${SLACK_SENDER_ID}"],
      channels: {
        "*": {
          enabled: true,
          requireMention: true,
          requireMentionInBotThreads: true,
          replyToMode: "all",
          allowBots: false,
          users: ["${SLACK_SENDER_ID}"],
        },
      },
      dm: { enabled: false, groupEnabled: false },
      dmPolicy: "disabled",
      implicitMentions: { replyToBot: false, threadParticipation: false },
      commands: { native: false, nativeSkills: false },
      slashCommand: { enabled: false },
      streaming: {
        mode: "off",
        nativeTransport: true,
        progress: {
          style: "card",
          nativeTaskCards: true,
          toolProgress: false,
          commandText: "status",
          commentary: false,
          narration: false,
        },
      },
      actions: { reactions: true },
    },
  },

  // The default Slack channel route goes to debugger. A peer binding with id "*"
  // matches any channel-kind peer on the default Slack account; DMs are
  // direct-kind and do not match (src/routing/route-binding-index.ts:241-250,
  // peer-kind-match.ts:5-13), and DMs are disabled above anyway.
  // accountId: use the Slack account id you added the app under ("default"
  // unless you passed --account), or "*" for every Slack account. A mismatch
  // makes the binding silently not match.
  bindings: [
    {
      agentId: "debugger",
      match: { channel: "slack", accountId: "default", peer: { kind: "channel", id: "*" } },
    },
  ],

  messages: {
    responseUsage: { default: "off", slack: "off" },
    groupChat: { visibleReplies: "automatic" },
  },
}
